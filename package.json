{
  "name": "agentstride",
  "private": true,
  "version": "0.0.0",
  "description": "AgentStride monorepo",
  "workspaces": [
    "packages/*",
    "examples/*",
    "evals"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @agentstride/core && npm run build --workspaces --if-present",
    "typecheck": "npm run build -w @agentstride/core && npm run typecheck --workspaces --if-present",
    "publish:check": "node scripts/publish-check.mjs",
    "examples:smoke": "npm start -w @agentstride/example-orchestrator-n-agents",
    "eval:enterprise-support": "npm run eval:enterprise-support -w @agentstride/evals-internal",
    "eval:human-approval": "npm run eval:human-approval -w @agentstride/evals-internal",
    "eval:alarm-triage": "npm run eval:alarm-triage -w @agentstride/evals-internal",
    "eval:change-gate": "npm run eval:change-gate -w @agentstride/evals-internal"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
