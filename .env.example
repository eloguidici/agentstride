# Copy to `.env` and fill in locally. Never commit real keys.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# OpenRouter (OpenAI-compatible). Used when OPENROUTER_API_KEY is set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Nest / HTTP examples (optional). When set, require header x-api-key.
AGENT_API_KEY=
PORT=3100
