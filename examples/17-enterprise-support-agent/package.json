{
  "name": "@agentstride/example-enterprise-support-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Enterprise support vertical slice: Receptionist + specialists + domain separation",
  "scripts": {
    "start": "npm run build -w @agentstride/core -w @agentstride/rag && node app.mjs",
    "start:live": "npm run build -w @agentstride/core -w @agentstride/rag -w @agentstride/openai && node run-live.mjs",
    "test": "npm run build -w @agentstride/core -w @agentstride/rag && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@agentstride/core": "*",
    "@agentstride/openai": "*",
    "@agentstride/rag": "*",
    "zod": "^4.5.4"
  }
}
