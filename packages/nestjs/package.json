{
  "name": "@agentstride/nestjs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS integration for AgentStride",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@agentstride/core": "*",
    "@nestjs/common": "^10.0.0 || ^11.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agentstride/core": "*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eloguidici/agentstride.git",
    "directory": "packages/nestjs"
  },
  "homepage": "https://github.com/eloguidici/agentstride#readme",
  "bugs": {
    "url": "https://github.com/eloguidici/agentstride/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
