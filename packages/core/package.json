{
  "name": "@agentstride/core",
  "version": "0.1.5",
  "type": "module",
  "description": "Small embeddable TypeScript agent runtime for POCs and production — tools, runs, cancel — without a workflow engine",
  "keywords": [
    "agents",
    "llm",
    "typescript",
    "openai",
    "agentstride"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.inference.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "zod": "^4.5.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eloguidici/agentstride.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/eloguidici/agentstride#readme",
  "bugs": {
    "url": "https://github.com/eloguidici/agentstride/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
