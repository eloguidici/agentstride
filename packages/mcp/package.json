{
  "name": "@agentstride/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP client and tool bridge for AgentStride",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3"
  },
  "peerDependencies": {
    "@agentstride/core": "*",
    "zod": "^3.25 || ^4.0"
  },
  "devDependencies": {
    "@agentstride/core": "*",
    "zod": "^4.5.4"
  }
}
